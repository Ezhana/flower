package flower:engine@0.1.0;

interface workflow-engine {
    enum node-kind {
        start,
        activity,
        finish,
    }

    record node-definition {
        id: string,
        kind: node-kind,
    }

    record edge-definition {
        id: string,
        source: string,
        target: string,
    }

    record workflow-definition {
        id: string,
        nodes: list<node-definition>,
        edges: list<edge-definition>,
    }

    enum execution-status {
        running,
        completed,
    }

    record execution-snapshot {
        workflow-id: string,
        status: execution-status,
        pending-node-id: option<string>,
        current-value: string,
        completed-node-ids: list<string>,
    }

    record execute-node-effect {
        node-id: string,
        input: string,
    }

    record transition {
        snapshot: execution-snapshot,
        effects: list<execute-node-effect>,
    }

    record engine-error {
        code: string,
        message: string,
    }

    start: func(
        workflow: workflow-definition,
        input: string,
    ) -> result<transition, engine-error>;

    complete-node: func(
        workflow: workflow-definition,
        snapshot: execution-snapshot,
        node-id: string,
        output: string,
    ) -> result<transition, engine-error>;
}

world engine {
    export workflow-engine;
}
