package flower:engine@0.1.0;

interface workflow-engine {
    record specification-version { major: u16, minor: u16 }
    enum node-kind { start, activity, finish }
    record node-definition { id: string, kind: node-kind }
    record edge-definition { id: string, source: string, target: string }
    record workflow-definition { id: string, nodes: list<node-definition>, edges: list<edge-definition> }
    record diagnostic { code: string, message: string, subject: option<string> }

    record plan-node { id: string, kind: node-kind }
    record executable-workflow-plan {
        specification-version: specification-version,
        workflow-id: string,
        fingerprint: string,
        nodes: list<plan-node>,
    }
    record plan-reference {
        specification-version: specification-version,
        workflow-id: string,
        fingerprint: string,
    }

    record payload { media-type: string, bytes: list<u8> }
    record awaiting-node { node-id: string, effect-id: string, input: payload }
    variant execution-state { awaiting-node(awaiting-node), completed(payload) }
    record execution-snapshot {
        execution-id: string,
        plan-reference: plan-reference,
        revision: u64,
        state: execution-state,
    }

    record execution-started-event {
        event-id: string,
        execution-id: string,
        plan-reference: plan-reference,
        input: payload,
    }
    record node-completed-event {
        event-id: string,
        execution-id: string,
        expected-revision: u64,
        effect-id: string,
        node-id: string,
        output: payload,
    }
    variant execution-event { execution-started(execution-started-event), node-completed(node-completed-event) }

    record execute-node-effect { effect-id: string, execution-id: string, node-id: string, input: payload }
    variant execution-effect { execute-node(execute-node-effect) }
    record transition-result { snapshot: execution-snapshot, effects: list<execution-effect> }
    record engine-error { code: string, message: string }

    compile: func(definition: workflow-definition) -> result<executable-workflow-plan, list<diagnostic>>;
    transition: func(plan: executable-workflow-plan, snapshot: option<execution-snapshot>, event: execution-event) -> result<transition-result, engine-error>;
}

world engine { export workflow-engine; }

// Binding-only world used by host SDK generators. The component exports only `engine`.
world engine-client { import workflow-engine; }
