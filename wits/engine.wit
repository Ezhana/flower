package flower:engine@0.1.0;

interface workflow-engine {
    enum node-kind { start, activity, finish }
    record fixed-backoff { delay-ms: u64 }
    record exponential-backoff {
        initial-delay-ms: u64,
        multiplier: u32,
        maximum-delay-ms: u64,
    }
    variant backoff-policy {
        none,
        fixed(fixed-backoff),
        exponential(exponential-backoff),
    }
    record retry-policy {
        max-attempts: u32,
        retryable-failure-codes: list<string>,
        backoff: backoff-policy,
    }
    record node-definition { id: string, kind: node-kind, retry-policy: option<retry-policy> }
    record edge-definition { id: string, source: string, target: string }
    record workflow-definition { id: string, nodes: list<node-definition>, edges: list<edge-definition> }
    record diagnostic { code: string, message: string, subject: option<string> }

    record plan-node { id: string, kind: node-kind, retry-policy: option<retry-policy> }
    record executable-workflow-plan {
        workflow-id: string,
        fingerprint: string,
        nodes: list<plan-node>,
    }
    record plan-reference {
        workflow-id: string,
        fingerprint: string,
    }

    record payload { media-type: string, bytes: list<u8> }
    record node-activation {
        activation-id: string,
        activation-revision: u64,
        node-id: string,
        input: payload,
    }
    record node-attempt { attempt-id: string, attempt-number: u32, effect-id: string }
    record attempt-failure { code: string, details: option<payload> }
    record retry-timer {
        timer-id: string,
        effect-id: string,
        failed-attempt-id: string,
        next-attempt-number: u32,
        delay-ms: u64,
    }
    record awaiting-attempt { activation: node-activation, attempt: node-attempt }
    record waiting-for-retry {
        activation: node-activation,
        attempt: node-attempt,
        failure: attempt-failure,
        timer: retry-timer,
    }
    record failed-execution {
        activation: node-activation,
        attempt: node-attempt,
        failure: attempt-failure,
    }
    variant execution-state {
        awaiting-attempt(awaiting-attempt),
        waiting-for-retry(waiting-for-retry),
        completed(payload),
        failed(failed-execution),
    }
    record execution-snapshot {
        execution-id: string,
        plan-reference: plan-reference,
        revision: u64,
        state: execution-state,
    }

    record execution-started-event {
        execution-id: string,
        plan-reference: plan-reference,
        input: payload,
    }
    record node-attempt-succeeded-event {
        execution-id: string,
        expected-revision: u64,
        activation-id: string,
        attempt-id: string,
        attempt-number: u32,
        effect-id: string,
        node-id: string,
        output: payload,
    }
    record node-attempt-failed-event {
        execution-id: string,
        expected-revision: u64,
        activation-id: string,
        attempt-id: string,
        attempt-number: u32,
        effect-id: string,
        node-id: string,
        failure: attempt-failure,
    }
    record timer-fired-event {
        execution-id: string,
        expected-revision: u64,
        timer-id: string,
        activation-id: string,
        next-attempt-number: u32,
    }
    variant execution-event {
        execution-started(execution-started-event),
        node-attempt-succeeded(node-attempt-succeeded-event),
        node-attempt-failed(node-attempt-failed-event),
        timer-fired(timer-fired-event),
    }

    record execute-node-attempt-effect {
        effect-id: string,
        activation-id: string,
        attempt-id: string,
        attempt-number: u32,
        node-id: string,
        input: payload,
    }
    record schedule-timer-effect {
        effect-id: string,
        timer-id: string,
        activation-id: string,
        failed-attempt-id: string,
        next-attempt-number: u32,
        delay-ms: u64,
    }
    variant execution-effect {
        execute-node-attempt(execute-node-attempt-effect),
        schedule-timer(schedule-timer-effect),
    }
    record transition-result { snapshot: execution-snapshot, effects: list<execution-effect> }
    record engine-error { code: string, message: string }

    compile: func(definition: workflow-definition) -> result<executable-workflow-plan, list<diagnostic>>;
    transition: func(plan: executable-workflow-plan, snapshot: option<execution-snapshot>, event: execution-event) -> result<transition-result, engine-error>;
}

world engine { export workflow-engine; }

// Binding-only world used by host SDK generators. The component exports only `engine`.
world engine-client { import workflow-engine; }
