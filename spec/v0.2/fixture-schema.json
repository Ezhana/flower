{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/spec/v0.2/fixture-schema.json",
  "title": "Flower conformance fixture v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "definition", "expected_compile", "steps"],
  "properties": {
    "schema_version": { "const": "flower.conformance/v0.2" },
    "name": { "$ref": "#/$defs/identifier" },
    "definition": { "$ref": "#/$defs/workflowDefinition" },
    "expected_compile": { "$ref": "#/$defs/compileExpectation" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/transitionStep" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "specificationVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "retry_policy"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["start", "activity", "finish"] },
        "retry_policy": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/retryPolicy" }
          ]
        }
      }
    },
    "backoffPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "delay_ms"],
          "properties": {
            "type": { "const": "fixed" },
            "delay_ms": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "initial_delay_ms", "multiplier", "maximum_delay_ms"],
          "properties": {
            "type": { "const": "exponential" },
            "initial_delay_ms": { "type": "integer", "minimum": 0 },
            "multiplier": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "maximum_delay_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "retryable_failure_codes", "backoff"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "retryable_failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "backoff": { "$ref": "#/$defs/backoffPolicy" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" }
      }
    },
    "workflowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "subject"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "subject": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        }
      }
    },
    "expectedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_version", "workflow_id", "fingerprint", "nodes"],
      "properties": {
        "specification_version": { "$ref": "#/$defs/specificationVersion" },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "compileExpectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "plan"],
          "properties": {
            "outcome": { "const": "plan" },
            "plan": { "$ref": "#/$defs/expectedPlan" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "diagnostics"],
          "properties": {
            "outcome": { "const": "diagnostics" },
            "diagnostics": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/diagnostic" }
            }
          }
        }
      ]
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_version", "workflow_id", "fingerprint"],
      "properties": {
        "specification_version": { "$ref": "#/$defs/specificationVersion" },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "bytes"],
      "properties": {
        "media_type": { "type": "string" },
        "bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "nodeActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_id", "activation_revision", "node_id", "input"],
      "properties": {
        "activation_id": { "$ref": "#/$defs/identifier" },
        "activation_revision": { "type": "integer", "minimum": 1 },
        "node_id": { "$ref": "#/$defs/identifier" },
        "input": { "$ref": "#/$defs/payload" }
      }
    },
    "nodeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "attempt_number", "effect_id"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "effect_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "attemptFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "details": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/payload" }
          ]
        }
      }
    },
    "retryTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timer_id", "effect_id", "failed_attempt_id", "next_attempt_number", "delay_ms"],
      "properties": {
        "timer_id": { "$ref": "#/$defs/identifier" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "failed_attempt_id": { "$ref": "#/$defs/identifier" },
        "next_attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "delay_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "executionState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "activation", "attempt"],
          "properties": {
            "type": { "const": "awaiting-attempt" },
            "activation": { "$ref": "#/$defs/nodeActivation" },
            "attempt": { "$ref": "#/$defs/nodeAttempt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "output"],
          "properties": {
            "type": { "const": "completed" },
            "output": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "activation", "attempt", "failure"],
          "properties": {
            "type": { "const": "failed" },
            "activation": { "$ref": "#/$defs/nodeActivation" },
            "attempt": { "$ref": "#/$defs/nodeAttempt" },
            "failure": { "$ref": "#/$defs/attemptFailure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "activation", "attempt", "failure", "timer"],
          "properties": {
            "type": { "const": "waiting-for-retry" },
            "activation": { "$ref": "#/$defs/nodeActivation" },
            "attempt": { "$ref": "#/$defs/nodeAttempt" },
            "failure": { "$ref": "#/$defs/attemptFailure" },
            "timer": { "$ref": "#/$defs/retryTimer" }
          }
        }
      ]
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "plan_reference", "revision", "state"],
      "properties": {
        "execution_id": { "$ref": "#/$defs/identifier" },
        "plan_reference": { "$ref": "#/$defs/planReference" },
        "revision": { "type": "integer", "minimum": 0 },
        "state": { "$ref": "#/$defs/executionState" }
      }
    },
    "executionEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "plan_reference", "input"],
          "properties": {
            "type": { "const": "execution-started" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "plan_reference": { "$ref": "#/$defs/planReference" },
            "input": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "expected_revision", "activation_id", "attempt_id", "attempt_number", "effect_id", "node_id", "output"],
          "properties": {
            "type": { "const": "node-attempt-succeeded" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "expected_revision": { "type": "integer", "minimum": 0 },
            "activation_id": { "$ref": "#/$defs/identifier" },
            "attempt_id": { "$ref": "#/$defs/identifier" },
            "attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "node_id": { "$ref": "#/$defs/identifier" },
            "output": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "expected_revision", "activation_id", "attempt_id", "attempt_number", "effect_id", "node_id", "failure"],
          "properties": {
            "type": { "const": "node-attempt-failed" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "expected_revision": { "type": "integer", "minimum": 0 },
            "activation_id": { "$ref": "#/$defs/identifier" },
            "attempt_id": { "$ref": "#/$defs/identifier" },
            "attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "node_id": { "$ref": "#/$defs/identifier" },
            "failure": { "$ref": "#/$defs/attemptFailure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "expected_revision", "timer_id", "activation_id", "next_attempt_number"],
          "properties": {
            "type": { "const": "timer-fired" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "expected_revision": { "type": "integer", "minimum": 0 },
            "timer_id": { "$ref": "#/$defs/identifier" },
            "activation_id": { "$ref": "#/$defs/identifier" },
            "next_attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          }
        }
      ]
    },
    "executionEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "effect_id", "activation_id", "attempt_id", "attempt_number", "node_id", "input"],
          "properties": {
            "type": { "const": "execute-node-attempt" },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "activation_id": { "$ref": "#/$defs/identifier" },
            "attempt_id": { "$ref": "#/$defs/identifier" },
            "attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "node_id": { "$ref": "#/$defs/identifier" },
            "input": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "effect_id", "timer_id", "activation_id", "failed_attempt_id", "next_attempt_number", "delay_ms"],
          "properties": {
            "type": { "const": "schedule-timer" },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "timer_id": { "$ref": "#/$defs/identifier" },
            "activation_id": { "$ref": "#/$defs/identifier" },
            "failed_attempt_id": { "$ref": "#/$defs/identifier" },
            "next_attempt_number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "delay_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "engineError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "transitionExpectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "snapshot", "effects"],
          "properties": {
            "outcome": { "const": "transition" },
            "snapshot": { "$ref": "#/$defs/executionSnapshot" },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/executionEffect" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "error"],
          "properties": {
            "outcome": { "const": "error" },
            "error": { "$ref": "#/$defs/engineError" }
          }
        }
      ]
    },
    "transitionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "event", "expected"],
      "properties": {
        "snapshot": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/executionSnapshot" }
          ]
        },
        "event": { "$ref": "#/$defs/executionEvent" },
        "expected": { "$ref": "#/$defs/transitionExpectation" }
      }
    }
  }
}
