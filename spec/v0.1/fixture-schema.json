{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/spec/v0.1/fixture-schema.json",
  "title": "Flower conformance fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "definition", "expected_compile", "steps"],
  "properties": {
    "schema_version": { "const": "flower.conformance/v0.1" },
    "name": { "$ref": "#/$defs/identifier" },
    "definition": { "$ref": "#/$defs/workflowDefinition" },
    "expected_compile": { "$ref": "#/$defs/compileExpectation" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/transitionStep" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "specificationVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["start", "activity", "finish"] }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" }
      }
    },
    "workflowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "subject"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "subject": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        }
      }
    },
    "expectedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_version", "workflow_id", "fingerprint", "nodes"],
      "properties": {
        "specification_version": { "$ref": "#/$defs/specificationVersion" },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "compileExpectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "plan"],
          "properties": {
            "outcome": { "const": "plan" },
            "plan": { "$ref": "#/$defs/expectedPlan" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "diagnostics"],
          "properties": {
            "outcome": { "const": "diagnostics" },
            "diagnostics": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/diagnostic" }
            }
          }
        }
      ]
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_version", "workflow_id", "fingerprint"],
      "properties": {
        "specification_version": { "$ref": "#/$defs/specificationVersion" },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "bytes"],
      "properties": {
        "media_type": { "type": "string" },
        "bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "executionState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "node_id", "effect_id", "input"],
          "properties": {
            "type": { "const": "awaiting-node" },
            "node_id": { "$ref": "#/$defs/identifier" },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "input": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "output"],
          "properties": {
            "type": { "const": "completed" },
            "output": { "$ref": "#/$defs/payload" }
          }
        }
      ]
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "plan_reference", "revision", "state"],
      "properties": {
        "execution_id": { "$ref": "#/$defs/identifier" },
        "plan_reference": { "$ref": "#/$defs/planReference" },
        "revision": { "type": "integer", "minimum": 0 },
        "state": { "$ref": "#/$defs/executionState" }
      }
    },
    "executionEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "plan_reference", "input"],
          "properties": {
            "type": { "const": "execution-started" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "plan_reference": { "$ref": "#/$defs/planReference" },
            "input": { "$ref": "#/$defs/payload" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "event_id", "execution_id", "expected_revision", "effect_id", "node_id", "output"],
          "properties": {
            "type": { "const": "node-completed" },
            "event_id": { "$ref": "#/$defs/identifier" },
            "execution_id": { "$ref": "#/$defs/identifier" },
            "expected_revision": { "type": "integer", "minimum": 0 },
            "effect_id": { "$ref": "#/$defs/identifier" },
            "node_id": { "$ref": "#/$defs/identifier" },
            "output": { "$ref": "#/$defs/payload" }
          }
        }
      ]
    },
    "executionEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "effect_id", "execution_id", "node_id", "input"],
      "properties": {
        "type": { "const": "execute-node" },
        "effect_id": { "$ref": "#/$defs/identifier" },
        "execution_id": { "$ref": "#/$defs/identifier" },
        "node_id": { "$ref": "#/$defs/identifier" },
        "input": { "$ref": "#/$defs/payload" }
      }
    },
    "engineError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "transitionExpectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "snapshot", "effects"],
          "properties": {
            "outcome": { "const": "transition" },
            "snapshot": { "$ref": "#/$defs/executionSnapshot" },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/executionEffect" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "error"],
          "properties": {
            "outcome": { "const": "error" },
            "error": { "$ref": "#/$defs/engineError" }
          }
        }
      ]
    },
    "transitionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "event", "expected"],
      "properties": {
        "snapshot": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/executionSnapshot" }
          ]
        },
        "event": { "$ref": "#/$defs/executionEvent" },
        "expected": { "$ref": "#/$defs/transitionExpectation" }
      }
    }
  }
}
